{
  "name": "wow-lovenselink",
  "version": "0.1.0",
  "description": "Lovense / Intiface integration for World of Warcraft (Forever): a tiny addon shows game events as a colour strip, the app reads it from the screen and drives your toy.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build:host": "dotnet build host/LovenseLinkHost.csproj -c Release -nologo -v q",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/strip.test.mjs test/intiface.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exeName": "WoW-LovenseLink",
  "app": {
    "title": "WoW LovenseLink",
    "dataFolder": "WoWLovenseLink",
    "accent": "#ff5c9a",
    "letter": "W"
  }
}
